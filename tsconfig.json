{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "esModuleInterop": true,
        "lib": [
            "es5",
            "es2015",
            "esnext",
            "dom"
        ],
        "types": [
            "node"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "sourceMap": true,
        "strict": true,
        "rootDir": "src",
        "outDir": "dist/esm",
        "target": "es6",
    },
    "include": [
        "src/**/*.ts",
    ]
}
